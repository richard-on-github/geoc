// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditAction {
  CREATION
  MODIFICATION
  VALIDATION
  SUPPRESSION
  REINITIALISATION_MOT_DE_PASSE
  REJET
  CORRECTION
  IMPORT
  CONNEXION
  DECONNEXION
}

enum DataScope {
  GLOBAL
  AGENCE
}

enum TypeImport {
  MANUEL
  EMAIL
  API
}

enum StatutEncaissement {
  NON_SOLDE
  PARTIELLEMENT_SOLDE
  SOLDE
}

enum StatutAnomalieBrouillard {
  OK
  MOINS_VERSE
  MOINS_VERSE_RETARD
  RETARD
  NON_VERSE
  TROP_VERSE
  ANOMALIE
}

enum StatutBrouillard {
  OUVERT
  CLOTURE
  VALIDE
  REJETE
}

model User {
  id String @id @default(cuid())

  prenom String
  nom    String

  email     String  @unique
  telephone String? @unique

  passwordHash String

  mustChangePassword Boolean @default(true)

  roleId String

  role Role @relation(fields: [roleId], references: [id])

  permissions UserPermission[]

  actif Boolean @default(true)

  agenceId String?
  agence   Agence? @relation(fields: [agenceId], references: [id])

  imports VenteImportLog[]

  ventesCloturees VenteCloture[]

  refreshTokens RefreshToken[]

  emailsAutorisesAjoutes EmailAutorise[]

  encaissements Encaissement[]

  abattementParametres AbattementParametres[]

  audits AuditLog[]

  brouillardsClotures Brouillard[] @relation("BrouillardCloture")
  brouillardsValides  Brouillard[] @relation("BrouillardValidation")
  brouillardsRejetes  Brouillard[] @relation("BrouillardRejet")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model RefreshToken {
  id String @id @default(cuid())

  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  expiresAt DateTime

  lastActivityAt DateTime @default(now())

  revoked Boolean @default(false)

  revokedAt DateTime?

  replacedBy String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  action AuditAction

  entity String

  entityId String?

  userId String?

  user User? @relation(fields: [userId], references: [id])

  agenceId String?
  agence   Agence? @relation(fields: [agenceId], references: [id])

  ip String?

  before Json?

  after Json?

  message String?

  createdAt DateTime @default(now())
}

model Role {
  id String @id @default(cuid())

  nom String

  code String @unique

  description String?

  niveau Int @default(1)

  isSystem Boolean @default(false)

  actif Boolean @default(true)

  dataScope DataScope @default(AGENCE)

  users User[]

  permissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Permission {
  id String @id @default(cuid())

  nom String

  code String @unique

  description String?

  roles RolePermission[]

  users UserPermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  roleId String

  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId String

  permissionId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Agence {
  id        String  @id @default(cuid())
  nom       String
  code      String  @unique
  adresse   String?
  telephone String?
  email     String?
  actif     Boolean @default(true)

  users  User[]
  ventes Vente[]
  audits AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VenteImportLog {
  id         String     @id @default(cuid())
  fileHash   String     @unique
  nomFichier String?
  typeImport TypeImport @default(MANUEL)
  lignes     Int        @default(0)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  ventes Vente[]

  createdAt DateTime @default(now())
}

model Vente {
  id String @id @default(cuid())

  agenceId  String?
  agence    Agence? @relation(fields: [agenceId], references: [id])
  agenceNom String?

  clotureId String?
  cloture   VenteCloture? @relation(fields: [clotureId], references: [id])

  kiosque    String
  agent      String
  banque     String?
  numeroTS10 String

  totalVente Decimal @default(0.00) @db.Decimal(15, 2)
  totalPaye  Decimal @default(0.00) @db.Decimal(15, 2)
  totalSolde Decimal @default(0.00) @db.Decimal(15, 2)

  dateDebut DateTime
  dateFin   DateTime

  jourAnnee Int
  mois      Int
  annee     Int

  statutEncaissement StatutEncaissement @default(NON_SOLDE)
  encaissements      Encaissement[]

  importId  String?
  importLog VenteImportLog? @relation(fields: [importId], references: [id], onDelete: SetNull)

  brouillard Brouillard?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agenceId])
  @@index([dateDebut, dateFin])
  @@index([numeroTS10])
}

enum StatutCloture {
  OUVERT
  CLOTURE
}

model VenteCloture {
  id          String   @id @default(cuid())
  periode     String   @unique // ex: "2026-07"
  dateDebut   DateTime
  dateFin     DateTime
  dateCloture DateTime @default(now())

  totalVentes Decimal @db.Decimal(12, 2)
  totalPayes  Decimal @db.Decimal(12, 2)
  totalSoldes Decimal @db.Decimal(12, 2)
  nbLignes    Int

  clotureParId String
  cloturePar   User   @relation(fields: [clotureParId], references: [id])

  ventes Vente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailAutorise {
  id          String   @id @default(cuid())
  email       String   @unique
  ajouteParId String
  ajoutePar   User     @relation(fields: [ajouteParId], references: [id])
  createdAt   DateTime @default(now())
}

model AbattementParametres {
  id String @id @default("singleton")

  heureLimiteUTC Int @default(13)

  tauxRetard Float @default(0.5)

  tauxMoinsVerse Float @default(1)

  tauxMoinsVerseAvecRetard Float @default(1.5)

  tauxNonVerse Float    @default(2)
  updatedAt    DateTime @updatedAt
  updatedParId String?
  updatedPar   User?    @relation(fields: [updatedParId], references: [id])
}

model Encaissement {
  id               String   @id @default(cuid())
  venteId          String
  vente            Vente    @relation(fields: [venteId], references: [id], onDelete: Cascade)
  montant          Decimal
  dateEncaissement DateTime
  enregistreParId  String
  enregistrePar    User     @relation(fields: [enregistreParId], references: [id])
  createdAt        DateTime @default(now())

  @@index([venteId])
}

model Brouillard {
  id         String   @id @default(cuid())
  venteId    String   @unique
  vente      Vente    @relation(fields: [venteId], references: [id], onDelete: Cascade)
  journee    DateTime
  agenceId   String?
  numeroTS10 String

  ventes       Decimal @db.Decimal(14, 2)
  /**
   * Gains de loterie payés aux gagnants ce jour-là. Aucune source de
   * données actuellement (ni import, ni saisie) : reste à 0 tant que ce
   * point n'est pas tranché avec le métier.
   */
  gainsPayes   Decimal @default(0) @db.Decimal(14, 2)
  soldeAttendu Decimal @db.Decimal(14, 2)
  montantVerse Decimal @default(0) @db.Decimal(14, 2)
  ecart        Decimal @default(0) @db.Decimal(14, 2)
  penalite     Decimal @default(0) @db.Decimal(14, 2)
  situation    String?

  statutAnomalie StatutAnomalieBrouillard @default(OK)
  statut         StatutBrouillard         @default(OUVERT)

  clotureParId   String?
  clotureParUser User?     @relation("BrouillardCloture", fields: [clotureParId], references: [id])
  clotureAt      DateTime?

  valideParId   String?
  valideParUser User?     @relation("BrouillardValidation", fields: [valideParId], references: [id])
  valideAt      DateTime?

  rejeteParId   String?
  rejeteParUser User?     @relation("BrouillardRejet", fields: [rejeteParId], references: [id])
  rejeteAt      DateTime?
  rejetRaison   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([numeroTS10])
  @@index([journee])
  @@index([statut])
}
